# Copy to .env and fill in. Never commit .env (it is in .gitignore).

# Public address of your server (used in emails and the QR code), without trailing slash
PUBLIC_URL=https://folio.example.org

# Allow new accounts (set to false once everyone you want has signed up)
ALLOW_SIGNUP=true
# Storage per user, in MB
QUOTA_MB=2048

# Email (account confirmation, password reset, sign-in alerts). Leave SMTP_HOST empty to print emails in the logs.
SMTP_HOST=smtp.example.org
SMTP_PORT=465
SMTP_USER=folio@example.org
SMTP_PASS=
MAIL_FROM=Folio <folio@example.org>

# Optional: Cloudflare Tunnel token (Zero Trust › Networks › Tunnels › your tunnel › token)
TUNNEL_TOKEN=
